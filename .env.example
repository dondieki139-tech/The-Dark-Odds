# Copy these into your backend host's encrypted environment variables.
# Never commit real values to GitHub.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://YOUR-BACKEND-DOMAIN/api/daraja/callback
# Use CustomerPayBillOnline for a PayBill shortcode. A Buy Goods Till may require CustomerBuyGoodsOnline.
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
DATA_DIR=./data
